# Database
DATABASE_URL=postgresql+asyncpg://investlearn:investlearn123@localhost:5432/investlearn
DATABASE_URL_SYNC=postgresql://investlearn:investlearn123@localhost:5432/investlearn

# Redis
REDIS_URL=redis://localhost:6379/0

# App
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# DeepSeek LLM (for AI-powered news analysis)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Crawler network
CRAWLER_HTTP_TIMEOUT=30.0
CRAWLER_RETRY_MAX=3
CRAWLER_RETRY_DELAY=2.0
HTTP_PROXY=
HTTPS_PROXY=

# AI content generation (false = real data only)
GENERATE_FAKE_CONTENT=false
